# ==============================================================================
# PABLO AI SOCIAL AGENT — Environment configuration template
# Copy to .env at the repo root (docker-compose reads it) and to apps/api/.env
# for local (non-docker) backend development. Never commit the real .env file.
# ==============================================================================

# ---- General -----------------------------------------------------------------
NODE_ENV=development
APP_NAME=PabloAISocialAgent
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=3000
TZ=UTC

# ---- Docker Compose host port overrides ----------------------------------------
# Change these only if the default ports are already used by another project on
# the same VPS (e.g. another docker-compose stack). Internal container-to-container
# communication is unaffected — only the host-side binding changes.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=4000
WEB_HOST_PORT=3000
HTTP_HOST_PORT=80

# ---- PostgreSQL ----------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=pablo_ai
POSTGRES_USER=pablo
POSTGRES_PASSWORD=change_me_strong_password
DATABASE_URL=postgresql://pablo:change_me_strong_password@postgres:5432/pablo_ai?schema=public

# ---- Redis / BullMQ ------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@redis:6379

# ---- Auth / Security -----------------------------------------------------------
JWT_ACCESS_SECRET=replace_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_with_openssl_rand_hex_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# 32-byte (64 hex chars) key used to AES-256-GCM encrypt third-party API keys at rest
ENCRYPTION_KEY=replace_with_openssl_rand_hex_32
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ---- OpenAI ----------------------------------------------------------------------
OPENAI_API_KEY=sk-replace-me
OPENAI_TEXT_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1

# ---- X (Twitter) API v2 -----------------------------------------------------------
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
PABLO_X_USERNAME=

# ---- Monitoring / Logging ----------------------------------------------------------
LOG_LEVEL=info
SENTRY_DSN=

# ---- Backups -------------------------------------------------------------------------
BACKUP_DIR=/var/backups/pablo-ai
BACKUP_RETENTION_DAYS=14
